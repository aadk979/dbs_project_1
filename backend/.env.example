# ============================================================
# EVENT ATTENDANCE TRACKING SYSTEM — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=yourpassword

# ---- JWT ----
# Use long, random, unpredictable strings (min 64 chars recommended)
JWT_ACCESS_SECRET=replace_with_a_very_long_random_access_secret_string_at_least_64_chars
JWT_REFRESH_SECRET=replace_with_a_very_long_random_refresh_secret_string_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Bcrypt ----
BCRYPT_SALT_ROUNDS=12

# ---- Nodemailer (SMTP) ----
# For development, use Ethereal: https://ethereal.email/
# For production, replace with your real SMTP provider (e.g., SendGrid, Mailgun)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password
EMAIL_FROM="Attendance System <no-reply@attendance.app>"

# ---- OAuth — Google ----
# Create credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ---- OAuth — GitHub ----
# Create credentials at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# ---- Frontend URL (for email links) ----
FRONTEND_URL=http://localhost:5173
